{
  "name": "@raystack/apsara",
  "version": "0.48.0",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./v1": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js",
      "require": "./dist/icons/index.cjs"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "require": "./dist/hooks/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./normalize.css": "./dist/normalize.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "build": "rollup --config",
    "dev": "rollup --config --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "release": "pnpm publish --access public --no-git-checks",
    "bump-version": "node scripts/bump-version.js",
    "clean": "rm -rf .turbo && rm -rf dist",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "figma:update-config": "node scripts/update-figma-config.js",
    "figma:validate-config": "node scripts/validate-figma-config.js",
    "figma:publish": "figma connect publish --force --skip-update-check --exit-on-unreadable-files",
    "figma:sync": "pnpm figma:update-config && pnpm figma:publish"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.ts"
      ],
      "v1": [
        "./dist/index.d.ts"
      ]
    }
  },
  "keywords": [
    "react",
    "components",
    "react-components",
    "ui",
    "design-system",
    "base-ui",
    "typescript",
    "raystack",
    "apsara",
    "component-library"
  ],
  "author": "",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/raystack/apsara.git",
    "directory": "packages/raystack"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.4.7",
    "@raystack/tools-config": "workspace:*",
    "@rollup/plugin-commonjs": "^25.0.2",
    "@rollup/plugin-node-resolve": "^15.1.0",
    "@rollup/plugin-typescript": "^11.1.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/culori": "^4.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/ui": "^3.2.4",
    "dotenv": "^17.2.2",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.548.0",
    "postcss": "^8.4.24",
    "postcss-import": "^16.1.0",
    "postcss-modules": "^6.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "rollup": "^3.25.1",
    "rollup-plugin-node-externals": "^5.1.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "rollup-plugin-tsconfig-paths": "^1.5.2",
    "semver": "^7.6.0",
    "typescript": "~5.4.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@base-ui/react": "~1.7.0",
    "@base-ui/utils": "~0.3.2",
    "@dnd-kit/core": "^6.3.1",
    "@tanstack/match-sorter-utils": "^8.8.4",
    "@tanstack/react-table": "^8.9.2",
    "@tanstack/react-virtual": "^3.13.13",
    "@tanstack/table-core": "^8.9.2",
    "class-variance-authority": "^0.7.1",
    "culori": "^4.0.2",
    "dayjs": "^1.11.23",
    "prism-react-renderer": "^2.4.1",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.4.1",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-model": "^1.25.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.40.0",
    "react-day-picker": "^9.6.7"
  },
  "peerDependencies": {
    "@types/react": "^19",
    "lucide-react": ">=0.500.0 <1.0.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}

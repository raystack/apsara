{
  "name": "@raystack/apsara",
  "version": "0.48.0",
  "browserslist": [
    "defaults",
    "safari >= 15",
    "ios_saf >= 15"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./v1": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./icons": {
      "import": {
        "types": "./dist/icons/index.d.ts",
        "default": "./dist/icons/index.js"
      },
      "require": {
        "types": "./dist/icons/index.d.cts",
        "default": "./dist/icons/index.cjs"
      }
    },
    "./hooks": {
      "import": {
        "types": "./dist/hooks/index.d.ts",
        "default": "./dist/hooks/index.js"
      },
      "require": {
        "types": "./dist/hooks/index.d.cts",
        "default": "./dist/hooks/index.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./style-no-fonts.css": "./dist/style-no-fonts.css",
    "./normalize.css": "./dist/normalize.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "check:package": "publint --strict && attw --pack . --exclude-entrypoints style.css style-no-fonts.css normalize.css",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "release": "pnpm publish --access public --no-git-checks",
    "clean": "rm -rf .turbo dist",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "figma:update-config": "node scripts/update-figma-config.cjs",
    "figma:validate-config": "node scripts/validate-figma-config.cjs",
    "figma:publish": "figma connect publish --force --skip-update-check --exit-on-unreadable-files",
    "figma:sync": "pnpm figma:update-config && pnpm figma:publish"
  },
  "typesVersions": {
    "*": {
      "icons": [
        "./dist/icons/index.d.ts"
      ],
      "hooks": [
        "./dist/hooks/index.d.ts"
      ],
      "v1": [
        "./dist/index.d.ts"
      ]
    }
  },
  "keywords": [
    "react",
    "components",
    "react-components",
    "ui",
    "design-system",
    "base-ui",
    "typescript",
    "raystack",
    "apsara",
    "component-library"
  ],
  "author": "",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raystack/apsara.git",
    "directory": "packages/react"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@figma/code-connect": "^1.4.7",
    "@raystack/tools-config": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.20.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/ui": "^5.1.2",
    "browserslist": "^4.29.6",
    "dotenv": "^17.2.2",
    "generic-names": "4.0.0",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.33.0",
    "lucide-react": "^1.45.0",
    "publint": "^0.3.25",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "rolldown": "~1.3.3",
    "semver": "^7.6.0",
    "typescript": "~7.0.2",
    "vite": "8.3.8",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "@base-ui/react": "~1.9.0",
    "@base-ui/utils": "~0.5.0",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@tanstack/match-sorter-utils": "^8.8.4",
    "@tanstack/react-table": "^8.9.2",
    "@tanstack/react-virtual": "^3.13.13",
    "@tanstack/table-core": "^8.9.2",
    "class-variance-authority": "^0.7.1",
    "culori": "^4.0.2",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.23",
    "marked": "^18.0.14",
    "prism-react-renderer": "^2.4.1",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.4.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-model": "^1.25.1",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-transform": "^1.12.1",
    "prosemirror-view": "^1.40.0",
    "react-day-picker": "~10.0.1"
  },
  "peerDependencies": {
    "@types/react": "^19",
    "lucide-react": ">=0.500.0 <2.0.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}

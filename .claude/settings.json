{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm test *)",
      "Bash(pnpm test:apsara)",
      "Bash(pnpm lint *)",
      "Bash(pnpm format *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec biome *)"
    ],
    "deny": ["Bash(npm *)", "Bash(yarn *)", "Bash(npx *)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
